# Copiar a `.env` (en la raíz) y completar. NUNCA commitear `.env`: ya está en .gitignore
# (verificar con `git check-ignore .env`). Sin GEMINI_API_KEY el worker arranca en MODO REPLAY
# (casetes de fixtures/casetes/, sin gastar cuota). Con GEMINI_API_KEY y MODO=real, ASR real
# (skills cuota-gemini y gemini-live). Detalle en el README.

# --- Gemini ---

# Obligatoria para ASR real. Empieza con AQ y un punto, unos 53 caracteres. Sin ella (o con MODO=replay): modo
# replay (no cumple R17a/R21 por sí solo, pero permite levantar y ver la demo sin gastar cuota).
GEMINI_API_KEY=

# Opcional. Key de un SEGUNDO proyecto de Google Cloud (cuota propia, independiente de la principal).
# Reserva de emergencia SÓLO para grabar el video si la key principal se queda sin cupo (skill
# cuota-gemini). No hace falta para levantar el proyecto ni para la demo.
GEMINI_API_KEY_RESERVA=

# Modelo de transcripción en vivo (skill gemini-live, medido contra la cuenta real: STT dedicado,
# PCM s16le 16kHz mono por WebSocket). Nombre de variable = el que lee worker/gemini.py. Modelo
# confirmado contra models.list() el 24/09 13:04 AR (bidiGenerateContent, 131072 tokens de entrada).
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Opcional. "1" relaja SÓLO la verificación VERIFY_X509_STRICT de SSL (visto con Avast + Python
# 3.13: la cadena de certificados se sigue verificando igual). No definida por default.
GEMINI_SSL_RELAX=

# Modelos de texto (familia flash-lite) para el segundo paso: traducir el texto final EN->ES /
# ES->EN (R19). `translation_config` de la Live API NO traduce (skill gemini-live), por eso hace
# falta un modelo de texto aparte. Free tier: 15 llamadas/min y 500/día por modelo (AI Studio,
# rate-limit, 24/09 13:10 AR); el traductor rota entre los dos y traduce por lotes (ver TRADUCTOR_*).
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TEXT_MODEL_ALT=gemini-3.1-flash-lite

# Tope de llamadas DIARIAS por modelo de texto que el traductor se autoimpone (worker/traductor.py,
# RPD_TOPE); se corta antes del límite real del free tier (500/día) para dejar margen. El límite de
# 12 RPM por modelo (RPM, token bucket) SÍ es configurable por entorno: ver TRADUCTOR_RPM y
# TRADUCTOR_TOPE_RPM más abajo, sección "Latencia y nivel pago" (nivel gratuito: no tocar).
TRADUCTOR_RPD_TOPE=480

# Lote del traductor: junta N ventanas de texto O espera S segundos desde el primer bloque
# pendiente (lo que ocurra primero) antes de mandar la llamada. Con lotes más chicos, en una
# corrida de B8, bajó bastante el atraso medido (ver README, "Reproducir los números de R19"); no
# está probado que eso valga para cualquier corrida (n=1 por configuración).
TRADUCTOR_LOTE_MAX=2
TRADUCTOR_LOTE_S=4
# Fallas seguidas (5xx, timeout, 429) de un modelo de texto que lo sacan de la rotación (queda sólo
# el otro modelo hasta que se cumpla TRADUCTOR_CORTE_S).
TRADUCTOR_FALLAS_CORTE=3
# Duración del primer corte de un modelo, y tope al que llega si se repiten los cortes (segundos).
TRADUCTOR_CORTE_S=60
TRADUCTOR_CORTE_MAX_S=480

# Hedge: si un lote no respondió en TRADUCTOR_HEDGE_S segundos, se lo manda TAMBIÉN al otro modelo
# sano con cupo libre y gana el primero que conteste (el otro se cancela). "0" apaga el hedge.
TRADUCTOR_HEDGE_S=4
# El pedido duplicado del hedge sólo sale si al otro modelo le quedan al menos N lugares libres en
# su ventana de 60 s (de esa key): así no le saca cupo a lotes nuevos (worker/README.md).
TRADUCTOR_HEDGE_MARGEN=3

# Las reservas de llamadas al modelo de texto (CUOTA_TEXTO_RESERVAS, tope 12/modelo/60 s) cuentan
# por (key, modelo), no por máquina: con --key distinta por sala, cada key tiene su propio tope
# (worker/README.md, "Cómo llegar a 5 y 10 salas").

# --- Cuota: presupuesto de audio y llamadas de texto (worker/cuota.py, worker/traductor.py) ---

# Archivo donde worker.run apenda una línea por corrida real (segundos de audio enviados a Gemini).
CUOTA_LOG=reportes/cuota-audio.log
# Presupuesto de audio del bloque de trabajo actual, en segundos, y desde cuándo se cuenta (formato
# "AAAA-MM-DD HH:MM:SS"). Sin saldo, worker.run sale con exit 4 sin conectar (skill cuota-gemini).
CUOTA_BLOQUE_S=1800
CUOTA_BLOQUE_DESDE=2026-09-24 13:00:00
# Una línea por llamada TERMINADA al modelo de texto (traducción); de ahí sale el tope diario.
CUOTA_TEXTO_LOG=reportes/cuota-texto.log
# Reservas de llamadas al modelo de texto COMPARTIDAS entre procesos (una sala = un proceso), con
# lock de archivo: evita pasarse del RPM cuando hay 2+ sesiones traduciendo con la misma key.
CUOTA_TEXTO_RESERVAS=reportes/cuota-texto-reservas.jsonl

# --- Worker: reabrir con solape (rotación/watchdog; worker/session.py, ConfigReabrir) ---
# Todos en SEGUNDOS de audio/reloj de pared enviado a la conexión con Gemini. Defaults elegidos
# sobre casetes reales (docstring de worker/session.py; reportes/audio-pipeline-b3.md y -b4-umbrales.log).

# Atraso sostenido (audio enviado - audioOffset del server) que dispara una reapertura por "atasco".
ATASCO_UMBRAL_S=22
# Cuánto tiempo tiene que sostenerse ese atraso por encima del umbral antes de reabrir.
ATASCO_SOSTENIDO_S=8
# Ventanas con voz enviadas sin NINGÚN texto (ni final ni parcial) del server: dispara "atasco" por mudo.
MUDO_S=10
# Refresco preventivo: segundos de audio enviados a UNA conexión antes de rotarla sola (tope
# observado del server ≈283 s; con 240 se rota antes de llegar ahí).
ROTACION_PREVENTIVA_S=240
# Cuánto se deja drenando la conexión vieja (por si todavía entrega texto) tras abrir la nueva.
DRENAJE_VIEJA_S=20
# Tope de segundos de audio que se reenvían a la conexión nueva al reabrir (ventanas que la vieja
# no llegó a cubrir).
REENVIO_MAX_S=15
# Si un envío de audio a Gemini falla o se traba más de estos segundos, la conexión se da por muerta y
# se reabre con rotation(cierre) (B7; default 5, no afinado).
ENVIO_TIMEOUT_S=5

# --- Hub (bus de mensajes; contrato en contracts/) ---

# Token de ingesta (worker -> hub, primer frame) y de acceso a GET /api/metricas (Bearer).
# OBLIGATORIO fuera de localhost: si el hub escucha en otra interfaz (Docker, red del evento) y el token
# es "dev-token", esta vacio o tiene menos de 16 caracteres, el hub NO arranca (exit 2). En localhost
# arranca con el default "dev-token" pero avisa en el log en cada arranque. Generar uno:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Nunca lo pases por query string (queda en los access logs): va en el primer frame del WebSocket o en
# Authorization: Bearer.
HUB_TOKEN=

# Host donde escucha el hub. Dev en Windows: localhost (127.0.0.1 + ::1; con 127.0.0.1 a secas un
# cliente que resuelve "localhost" a ::1 primero puede tardar en caer a IPv4). En Docker: 0.0.0.0
# (si no, sólo escucha dentro del propio contenedor y no se llega desde afuera). En
# ops/docker-compose.yml este valor va HARDCODEADO a 0.0.0.0 para el servicio hub, no se lee de acá.
HUB_HOST=localhost

# Puerto de la API/WebSocket del hub (y de los estáticos, con --web/--panel). Dev: 8100. Despliegue
# (docker compose, puerto único del proyecto): 8080 — también hardcodeado en
# ops/docker-compose.yml, no se lee de acá.
HUB_PORT=8100

# Carpetas que el hub sirve además de la API (equivalen a `python -m hub --web <dir> --panel <dir>`;
# el flag de línea de comando, si se usa, gana sobre esto). Vacío: GET / sólo devuelve la lista de
# rutas. En ops/docker-compose.yml se pasan como flags (`--web web --panel panel`), no por acá.
HUB_WEB_DIR=
HUB_PANEL_DIR=

# --- Web y panel (puertos de desarrollo, servidores estáticos aparte del hub) ---
WEB_PORT=8101
PANEL_PORT=8102

# --- Modo del worker en Docker (ops/entrypoint-worker.sh) ---

# replay | real. "replay" reproduce en bucle los casetes *-trad*.jsonl de fixtures/casetes/ contra
# el hub (rotulado replay; NO satisface R17a/R21 por sí solo: skill contexto, eje 3 de C3). "real"
# sólo hace ASR real si además hay GEMINI_API_KEY; si falta, cae a replay con aviso. MODO=replay es
# un override DURO: fuerza replay aunque GEMINI_API_KEY esté completa (así
# `MODO=replay docker compose up` nunca gasta cuota).
MODO=replay

# Opcional, sólo en modo replay: si se define, el worker reproduce en bucle ESTE único casete (una
# sola sesión) en vez de descubrir automáticamente todos los *-trad*.jsonl de fixtures/casetes/.
CASETE_REPLAY=

# --- Video de entrega (opcional, NO hace falta para levantar el proyecto) ---

# Key de Cartesia (texto a voz), usada SÓLO por docs/video/narrar_cartesia.py para generar la
# narración del video de entrega (R13a/R13b). No la usa el worker ni el hub. Sin esta variable el
# proyecto funciona igual; sólo no se puede regenerar la narración del video.
CARTESIA_API_KEY=

# --- Latencia y nivel pago (25/09; docs/evidencia.md, sección 1c) ---
# Topes propios del traductor por (key, modelo). Defaults = nivel gratuito. En nivel pago, poner los
# valores de la vista de límites de AI Studio del proyecto, p. ej. TRADUCTOR_RPM=300 TRADUCTOR_TOPE_RPM=400.
# TRADUCTOR_RPM=12
# TRADUCTOR_TOPE_RPM=15
# Traducción de cada línea apenas llega si hay cupo (inmediato) o en lotes (lote).
# TRADUCTOR_MODO=inmediato
# Ventana de audio por turno, en segundos. 3 = default (nivel gratuito). Con nivel pago, 2 baja el
# original a ~2,3 s sin perder texto (medido).
# VENTANA_S=3
