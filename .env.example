# Copiar a `.env` (en la raíz) y completar. NUNCA commitear `.env`: ya está en .gitignore.
# Sin GEMINI_API_KEY el worker arranca en MODO REPLAY (casetes de fixtures/casetes/, sin gastar
# cuota). Con GEMINI_API_KEY, ASR real (skills cuota-gemini y gemini-live). Detalle en el README.

# --- Gemini ---

# Obligatoria para ASR real. Formato AQ., ~53 caracteres. Sin ella: modo replay (no cumple R17a/R21
# por sí solo, pero permite levantar y ver la demo sin gastar cuota).
GEMINI_API_KEY=

# Opcional. Key de un SEGUNDO proyecto de Google Cloud (cuota propia, independiente de la principal).
# Reserva de emergencia SÓLO para grabar el video si la key principal se queda sin cupo (skill
# cuota-gemini). No hace falta para levantar el proyecto ni para la demo.
GEMINI_API_KEY_RESERVA=

# Modelo de transcripción en vivo (skill gemini-live, medido contra la cuenta real: STT dedicado,
# PCM s16le 16kHz mono por WebSocket).
# Nombre de variable = el que lee worker/gemini.py. Modelo confirmado contra models.list() el
# 24/09 13:04 AR (bidiGenerateContent, 131072 tokens de entrada).
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Modelos de texto (familia flash-lite) para el segundo paso: traducir el texto final EN->ES (R19).
# `translation_config` de la Live API NO traduce (skill gemini-live) por eso hace falta un modelo de
# texto aparte. En free tier cada uno tiene 15 llamadas/min y 500/día (AI Studio, rate-limit,
# 24/09 13:10): el traductor rota entre los dos y traduce por lotes. Nombres a confirmar por
# audio-pipeline contra models.list() en B2.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TEXT_MODEL_ALT=gemini-3.1-flash-lite

# --- Hub (bus de mensajes; contrato en contracts/) ---

# Token de ingesta (worker -> hub) y de acceso al panel de monitoreo. Cambiar en producción.
HUB_TOKEN=dev-token
HUB_PORT=8100

# --- Web y panel (puertos de desarrollo) ---
WEB_PORT=8101
PANEL_PORT=8102

# --- Proyecto ---

# Puerto único de salida del proyecto ya armado (docker compose). En dev cada servicio usa su propio
# puerto (HUB_PORT/WEB_PORT/PANEL_PORT); cómo se consolida todo en éste queda para B7 (README/compose).
PUERTO_PROYECTO=8080

# Etiqueta informativa del modo activo: real | replay. El worker decide solo (real si hay
# GEMINI_API_KEY, replay si no; ver ops/entrypoint-worker.sh). Pendiente confirmar con
# backend/audio-pipeline si además la lee el hub o el panel para rotular la UI como "replay".
MODO=replay
